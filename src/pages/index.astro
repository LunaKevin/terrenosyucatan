<script>
window.addEventListener("DOMContentLoaded", () => {

  const PHONE = "529992768570";

  function buildMessage() {
    const rtext = document.getElementById("b_website")?.value || "";
    const nombre = document.getElementById("nombre")?.value || "";
    const telefono = document.getElementById("phoneNumber")?.value || "";
    const uso = document.getElementById("uso")?.value || "";
    const consentimiento = document.querySelector('input[name="consentimiento"]')?.checked;

    if (nombre && telefono && uso && consentimiento) {
      return `Hola, soy ${nombre}, me interesa más información sobre terrenos en Yucatán.`;
    }
    return "Hola, quiero información sobre terrenos en Yucatán";
  }

  function sendToWhatsApp(e){
    e.preventDefault();
    const mensaje = buildMessage();
    window.open(`https://wa.me/${PHONE}?text=${encodeURIComponent(mensaje)}`, "_blank");
  }

  document.querySelectorAll(".whatsapp-btn").forEach(btn => {
    btn.addEventListener("click", sendToWhatsApp);
  });

  const form = document.getElementById("leadForm");

  if (form) {
    form.addEventListener("submit", sendToWhatsApp);
  }

  // LIGHTBOX MEJORADO (IMAGEN COMPLETA)
  const images = document.querySelectorAll(".gallery img");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");

  images.forEach(img => {
    img.addEventListener("click", () => {
      lightbox.style.display = "flex";

      //  usa la imagen ORIGINAL sin recorte
      lightboxImg.src = img.src;

      lightboxImg.style.objectFit = "contain";
    });
  });

  lightbox.addEventListener("click", () => {
    lightbox.style.display = "none";
  });

});
</script>

